<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for the Java template.

  Suppression policy (docs/PHILOSOPHY.md principle 2): every <Match> below
  must carry an XML comment naming the exact false-positive class it silences
  and why the code is correct. An entry without a justification is treated as
  gate tampering and rejected in review. Prefer fixing the code over adding
  entries here.
-->
<FindBugsFilter>

  <!-- Repository adapters return Order snapshots (a mutable state machine).
       SpotBugs EI_EXPOSE_REP / EI_EXPOSE_REP2 cannot tell a detached snapshot
       copy from a leaked internal reference: save/get/remember clone before
       returning (CONTRACTS.md §2 snapshot isolation), but the returned type
       is still a mutable Order. The exclude covers that false-positive class;
       production code outside adapters must not rely on it. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
